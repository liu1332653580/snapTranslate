# SnapOCR 环境变量示例
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。

# === VLM API key ===
# 智谱 GLM —— 去 https://bigmodel.cn/ 控制台申请
VITE_GLM_API_KEY=

# OpenAI（兜底用，可选）
VITE_OPENAI_API_KEY=

# Google Gemini（评估对比用，可选）
VITE_GEMINI_API_KEY=

# === 评估脚本用（不暴露到前端）===
GLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
