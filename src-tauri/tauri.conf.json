{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapOCR",
  "version": "0.1.0",
  "identifier": "com.snapocr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnapOCR",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": true,
        "center": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      },
      {
        "label": "overlay",
        "title": "SnapOCR Capture",
        "width": 1920,
        "height": 1080,
        "fullscreen": false,
        "maximized": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "index.html#/overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://open.bigmodel.cn https://api.openai.com https://generativelanguage.googleapis.com https://*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'",
      "dangerousUseHttpScheme": false
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "SnapOCR — 按 Ctrl+Shift+O 截图"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Screenshot to structured Markdown",
    "longDescription": "Capture any screen region and get clean, structured Markdown powered by GLM-4.6V."
  }
}
